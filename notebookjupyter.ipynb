   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = np.linspace(0, 10, 100)\n",
    "y = np.sin(x)\n",
    "\n",
    "plt.plot(x, y)\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"sin(x)\")\n",
    "plt.title(\"Una semplice funzione sinusoidale\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6b734fcc-a8d8-4b1a-97eb-f949311fd871",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Media dei valori:\", np.mean(y))"
   ]
  }
